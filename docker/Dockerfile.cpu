# syntax=docker/dockerfile:1
# CPU image: the server plus ffmpeg (video containers) and pdftoppm (PDF pages)
# on Debian slim.
#
#   docker build -f docker/Dockerfile.cpu -t embeddinggemma-api:cpu .
#   docker run --rm -p 3000:3000 -v embeddinggemma-models:/models embeddinggemma-api:cpu
#
# Fill the volume once:   docker run --rm -v embeddinggemma-models:/models embeddinggemma-api:cpu download embeddinggemma-2
# Bake the model in:      docker build -f docker/Dockerfile.cpu --target bake -t embeddinggemma-api:cpu-model .
#                         (needs ./models/embeddinggemma-2 — `embeddinggemma_api download embeddinggemma-2`)

FROM rust:1-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p embeddinggemma_api \
    && cp target/release/embeddinggemma_api /embeddinggemma_api

FROM debian:bookworm-slim AS base
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg poppler-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /embeddinggemma_api /usr/local/bin/embeddinggemma_api
ENV EMBEDDINGGEMMA_MODEL_DIR=/models EMBEDDINGGEMMA_MODELS=embeddinggemma-2 EMBEDDINGGEMMA_DEVICE=cpu \
    EMBEDDINGGEMMA_HOST=0.0.0.0 EMBEDDINGGEMMA_PORT=3000 HF_HOME=/models/.hf-cache
VOLUME ["/models"]
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/embeddinggemma_api"]

# Opt-in: the model baked into the image (`--target bake`).
FROM base AS bake
COPY models/ /models/

# Default (last stage): binary only, model from the /models volume.
FROM base AS runtime
